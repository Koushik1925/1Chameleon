{
  "name": "agent",
  "version": "1.1.0",
  "main": "src/main.js",
  "scripts": {
    "start": "set ELECTRON_RUN_AS_NODE=0 && electron .",
    "build": "electron-builder"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Silent remote desktop agent",
  "build": {
    "appId": "com.chameleon.agent",
    "productName": "Chameleon Agent",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "identity": null,
      "category": "public.app-category.utilities"
    },
    "dmg": {
      "title": "Chameleon Installer",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true
    },
    "extraFiles": [
      "assets/**/*"
    ]
  },
  "dependencies": {
    "@nut-tree-fork/nut-js": "^4.2.6",
    "electron-store": "^11.0.2",
    "qrcode": "^1.5.4",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "electron": "^28.2.10",
    "electron-builder": "^26.8.1"
  }
}