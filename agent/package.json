{
  "name": "agent",
  "version": "1.4.1",
  "main": "src/main.js",
  "scripts": {
    "start": "node start.js",
    "build": "electron-builder",
    "test": "node --test test/*.test.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Silent remote desktop agent",
  "build": {
    "appId": "com.service.network",
    "productName": "Chameleon Desktop Agent",
    "icon": "build/icon.png",
    "artifactName": "Chameleon-Desktop-Agent-Setup-${version}.${ext}",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "identity": null,
      "category": "public.app-category.utilities"
    },
    "dmg": {
      "title": "Service Host Installer",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true
    },
    "extraResources": [
      "assets/**/*"
    ]
  },
  "dependencies": {
    "@nut-tree-fork/nut-js": "^4.2.6",
    "axios": "^1.19.0",
    "electron-store": "^11.0.2",
    "qrcode": "^1.5.4",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "electron": "^28.2.10",
    "electron-builder": "^26.8.1"
  }
}
