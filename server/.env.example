MONGODB_URI=mongodb://localhost:27017/chameleon_admin
JWT_SECRET=super_secret_jwt_key_12345
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
PORT=5000

# ── WebRTC relay (TURN) — OPTIONAL, fallback-only ─────────────────────────────────────────────────
# NOT needed for normal use: peers connect directly through free public STUN servers, exactly as before.
# If you leave these unset nothing changes. If you set them, TURN is used ONLY as a fallback: every
# connection tries a direct (STUN) path first, and the relay is handed to both peers only after that
# direct attempt has failed. Networks that can connect directly never touch the relay.
# Only useful for network pairs that cannot connect directly (e.g. both behind symmetric NAT).
# Any TURN provider works (Metered, Xirsys, Twilio, Cloudflare Calls, self-hosted coturn).
#
# Restrictive networks (UDP blocked, corporate firewalls, carrier NAT) need the relay reachable over ALL of:
#   UDP 3478 (fastest), TCP 3478 (UDP blocked), TLS on 443 (looks like HTTPS: passes almost any firewall).
# ICE tries every offered transport and picks the best one that works - users configure nothing.
#
# Option 0 (no server to run): Cloudflare Realtime TURN - short-lived credentials generated by the backend.
# CLOUDFLARE_TURN_KEY_ID=your_turn_key_id
# CLOUDFLARE_TURN_API_TOKEN=your_turn_key_api_token
# CLOUDFLARE_TURN_TTL_SECONDS=86400
# See docs/TURN_SETUP.md for the full walkthrough (including self-hosted coturn).
#
# Easiest self-hosted: just the hostname. Generates turn:HOST:3478 (udp), turn:HOST:3478?transport=tcp and turns:HOST:443.
# TURN_HOST=turn.example.com
# TURN_PORT=3478
# TURNS_PORT=443
# Or an explicit list (takes precedence over TURN_HOST):
# TURN_URLS=turn:turn.example.com:3478,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:443?transport=tcp
# GET /signaling-status then reports turnTransports (e.g. ["udp","tcp","tls"]) and warns if the set is incomplete.
# Option A - static credentials from the provider dashboard:
# TURN_USERNAME=your_turn_username
# TURN_CREDENTIAL=your_turn_credential
# Option B - coturn "static-auth-secret": short-lived credentials are derived per join:
# TURN_SECRET=your_coturn_static_auth_secret
# TURN_TTL_SECONDS=86400   # a relayed session ends when its credential expires: keep it > your longest session

# ── Signaling tunables (optional; defaults shown) ────────────────────────────────────────────────
# AGENT_RECONNECT_GRACE_MS=20000   # keep a session this long after the host's signaling socket drops
# CLIENT_RECONNECT_GRACE_MS=12000  # keep the host streaming this long after a viewer's socket drops unexpectedly
# COLD_START_GRACE_MS=120000       # after a (re)start, "session not found" is reported as retryable for this long
# SOCKET_PING_INTERVAL_MS=15000
# SOCKET_PING_TIMEOUT_MS=15000
# SIGNALING_LOG_LEVEL=info         # debug | info | warn | error
# LOG_FULL_SESSION_IDS=false       # true disables masking of session codes in logs (debugging only)
